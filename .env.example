# Web Application & Port
PRICE_GETTER_PUBLIC_PORT=8000

# Authentication & Security
# Generate a random 32+ character string for production
JWT_SECRET=change_this_to_a_random_secure_secret_in_production_32chars
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123456

# External Trigger / OS Cron Key
TRIGGER_API_KEY=

# Logging & Timezone
# APP_TIMEZONE controls schedule windows and log timestamps (default: Asia/Tehran)
APP_TIMEZONE=Asia/Tehran
# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Market polling interval in minutes (default: 60).
# Market products share one API response, so with a 50 req/day quota keep this
# at 60 or higher, or narrow each product's active hour window instead.
MARKET_POLL_INTERVAL_MINUTES=60

# Market Adapter API Keys
brsapi_api=
SERVIX_API_KEY=
